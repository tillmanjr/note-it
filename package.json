{
  "name": "tdjr-info-service",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "desktop": "npm run tauri:dev -w @tdjr/desktop",
    "server": "npm run dev -w @tdjr/server"
  }
}
