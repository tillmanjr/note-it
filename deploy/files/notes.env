# Sync server settings on the droplet (/etc/notes/env, root-owned 600). None of these is a secret: the database
# is reached over its Unix socket as the `notes` OS user (peer authentication, no password), and device
# sessions are random tokens the server stores only as hashes.
DATABASE_URL=postgresql://notes@/notes?host=/var/run/postgresql
HOST=127.0.0.1
PORT=5319
BLOB_DIR=/var/lib/notes/blobs
# The apps' origins: the desktop release build, the Android tablet app (https://localhost), and the desktop dev build (npm run desktop), which may talk to the droplet too.
# Requests carry bearer tokens, never cookies, so an allowed origin grants nothing without a session.
CORS_ORIGINS=http://tauri.localhost,tauri://localhost,http://localhost:5318,https://localhost
RP_ID=notes.tillmanjr.com
RP_NAME=Notes
PASSKEY_ORIGINS=https://notes.tillmanjr.com
TRUST_PROXY=1
NODE_ENV=production
